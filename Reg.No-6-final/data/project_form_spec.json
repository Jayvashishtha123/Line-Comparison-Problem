  "validation_rules": {
    "date_validation": {
      "future_dates": "estd_end_date and adjusted_end_date must be in the future",
      "date_comparison": "adjusted_end_date (if provided) should generally be after or equal to estd_end_date",
      "format": "YYYY-MM-DD"
    },
    "enum_validation": {
      "state": "Must match one of: Funnel, Evaluation, Hold, Active, Closure, Cancelled",
      "project_otd_status": "Must match one of the allowed OTD status values",
      "project_otd_phase": "Must match one of the allowed phase values",
      "dt_team_accountable": "Must match one of the DT teams from LOV"
    },
    "required_field_logic": {
      "category_conditional": "Required if state == 'Funnel'; otherwise optional",
      "all_other_conditional": "Project Status, OTD Status, Phase, and Adjusted End Date visibility depend on state/OTD status rules",
      "otd_status_active_required": "OTD Status is required when state == 'Active'"
    },
    "status_phase_logic": {
      "project_status_blank_when_state_in": [],
      "otd_status_null_when_state_in": [
        "Funnel",
        "Evaluation",
        "Hold"
      ],
      "otd_status_required_when_state_in": [
        "Active"
      ],
      "phase_optional_when_state_in": [
        "Funnel"
      ],
      "adjusted_end_date_required_when_otd_status": "Adjusted Plan"
    },
    "text_validation": {
      "project_name": "1-255 characters, required",
      "initiative_name": "1-255 characters, required",
      "description": "1-2000 characters, required",
      "executive_sponsor": "1-255 characters, required email",
      "dt_teams_involved": "Optional pick list from DT Team Accountable LOV",
      "dt_lead": "1-255 characters, required email",
      "business_project_lead": "1-255 characters, required email",
      "technology": "0-255 characters, optional"
    },
    "numeric_validation": {
      "budget": "Non-negative number, optional"
    }
  },
  "form_defaults": {
    "state": "Evaluation",
    "project_otd_status": "On-Track",
    "project_otd_phase": "Discovery",
    "adjusted_end_date": ""
  },
  "system_generated_fields": [
    "project_otd_status",
    "filter_key"
  ],
